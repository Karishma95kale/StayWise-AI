<%- include('./partials/header') -%>

<!-- 1. Hero Section -->
<section class="position-relative py-5 overflow-hidden" style="background: linear-gradient(180deg, rgba(248, 249, 252, 0.6) 0%, rgba(20, 33, 61, 0.05) 100%);">
  <div class="container py-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-7 animate-slide-up">
        <span class="badge-pink mb-3 d-inline-block shadow-sm">
          <i class="fa-solid fa-sparkles me-1"></i> #1 AI Student Accommodation Platform
        </span>
        <h1 class="display-hero mb-3">
          Find Your Perfect <br>
          <span style="background: var(--accent-pink-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Student Home</span>
        </h1>
        <p class="fs-5 text-muted mb-4 leading-relaxed" style="max-width: 580px;">
          AI-Powered Hostel, PG & Student Living Platform. Discover verified accommodations near top universities with zero brokerage and AI safety metrics.
        </p>

        <div class="d-flex flex-wrap gap-3">
          <a href="#properties" class="btn btn-pink-gradient btn-lg">
            Explore Properties <i class="fa-solid fa-arrow-down ms-1"></i>
          </a>
          <a href="/ai/assistant" class="btn btn-navy btn-lg">
            <i class="fa-solid fa-robot me-2" style="color: var(--primary-pink);"></i> Try AI Recommendation
          </a>
        </div>
      </div>

      <div class="col-lg-5 animate-fade-in">
        <div class="position-relative">
          <div class="startup-card p-2 shadow-lg">
            <img src="https://images.unsplash.com/photo-1555854877-bab0e564b8d5?auto=format&fit=crop&w=1000&q=80" class="img-fluid rounded-4" alt="Student Lifestyle">
          </div>
          <!-- Floating Badge -->
          <div class="position-absolute bottom-0 start-0 translate-middle-y bg-white p-3 rounded-4 shadow-lg border d-flex align-items-center gap-3 ms-n3 mb-n3" style="max-width: 260px;">
            <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success fs-3">
              <i class="fa-solid fa-shield-check"></i>
            </div>
            <div>
              <div class="fw-bold text-dark small">100% Verified Hostels</div>
              <div class="text-muted text-xs">Biometric & 24/7 Guards</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Floating Search Bar -->
    <div class="floating-search-box animate-slide-up">
      <form action="/listings" method="GET">
        <div class="row g-3 align-items-center">
          <div class="col-lg-3 col-md-6 search-field-group">
            <label class="text-muted text-xs font-weight-bold text-uppercase d-block mb-1"><i class="fa-solid fa-location-dot me-1 text-pink" style="color: var(--primary-pink);"></i> Location / City</label>
            <input type="text" name="search" class="form-control search-input-custom ps-0" placeholder="e.g. GTB Nagar, Pune..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
          </div>

          <div class="col-lg-3 col-md-6 search-field-group">
            <label class="text-muted text-xs font-weight-bold text-uppercase d-block mb-1"><i class="fa-solid fa-graduation-cap me-1 text-navy"></i> Nearby College</label>
            <input type="text" name="college" class="form-control search-input-custom ps-0" placeholder="e.g. DU, IIT, Symbiosis..." value="<%= queryFilters && queryFilters.college ? queryFilters.college : '' %>">
          </div>

          <div class="col-lg-2 col-md-4 search-field-group">
            <label class="text-muted text-xs font-weight-bold text-uppercase d-block mb-1"><i class="fa-solid fa-wallet me-1 text-success"></i> Max Budget</label>
            <input type="number" name="maxPrice" class="form-control search-input-custom ps-0" placeholder="₹12,000" value="<%= queryFilters && queryFilters.maxPrice ? queryFilters.maxPrice : '' %>">
          </div>

          <div class="col-lg-2 col-md-4 search-field-group">
            <label class="text-muted text-xs font-weight-bold text-uppercase d-block mb-1"><i class="fa-solid fa-user-group me-1 text-info"></i> Gender</label>
            <select name="gender" class="form-select search-input-custom ps-0">
              <option value="All">All Types</option>
              <option value="Boys" <%= queryFilters && queryFilters.gender === 'Boys' ? 'selected' : '' %>>Boys</option>
              <option value="Girls" <%= queryFilters && queryFilters.gender === 'Girls' ? 'selected' : '' %>>Girls</option>
              <option value="Co-ed" <%= queryFilters && queryFilters.gender === 'Co-ed' ? 'selected' : '' %>>Co-ed</option>
            </select>
          </div>

          <div class="col-lg-2 col-md-4">
            <button type="submit" class="btn btn-pink-gradient w-100 py-3 rounded-pill fw-bold">
              <i class="fa-solid fa-magnifying-glass me-1"></i> Search
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<!-- 3. Popular Cities Section -->
<section class="py-5 bg-white">
  <div class="container py-3">
    <div class="text-center mb-5">
      <span class="badge-navy mb-2 d-inline-block">Top Student Hubs</span>
      <h2 class="section-heading">Explore Popular College Cities</h2>
      <p class="text-muted">Find verified student housing near India's top academic hubs</p>
    </div>

    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <a href="/listings?search=Delhi" class="text-decoration-none">
          <div class="city-card">
            <img src="https://images.unsplash.com/photo-1587474260584-136574528ed5?auto=format&fit=crop&w=800&q=80" alt="Delhi">
            <div class="city-overlay">
              <h3 class="fw-bold text-white mb-1">Delhi NCR</h3>
              <p class="text-light small mb-0"><i class="fa-solid fa-graduation-cap me-1"></i> DU North Campus, IIT Delhi, Jamia</p>
            </div>
          </div>
        </a>
      </div>

      <div class="col-lg-4 col-md-6">
        <a href="/listings?search=Mumbai" class="text-decoration-none">
          <div class="city-card">
            <img src="https://images.unsplash.com/photo-1567157577867-05ccb1388e66?auto=format&fit=crop&w=800&q=80" alt="Mumbai">
            <div class="city-overlay">
              <h3 class="fw-bold text-white mb-1">Mumbai</h3>
              <p class="text-light small mb-0"><i class="fa-solid fa-graduation-cap me-1"></i> IIT Bombay, NMIMS, St. Xavier's</p>
            </div>
          </div>
        </a>
      </div>

      <div class="col-lg-4 col-md-6">
        <a href="/listings?search=Bengaluru" class="text-decoration-none">
          <div class="city-card">
            <img src="https://images.unsplash.com/photo-1596176530529-78163a4f7af2?auto=format&fit=crop&w=800&q=80" alt="Bangalore">
            <div class="city-overlay">
              <h3 class="fw-bold text-white mb-1">Bangalore</h3>
              <p class="text-light small mb-0"><i class="fa-solid fa-graduation-cap me-1"></i> Christ University, IISc, Koramangala</p>
            </div>
          </div>
        </a>
      </div>

      <div class="col-lg-6 col-md-6">
        <a href="/listings?search=Pune" class="text-decoration-none">
          <div class="city-card" style="height: 240px;">
            <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=800&q=80" alt="Pune">
            <div class="city-overlay">
              <h3 class="fw-bold text-white mb-1">Pune</h3>
              <p class="text-light small mb-0"><i class="fa-solid fa-graduation-cap me-1"></i> Symbiosis, Fergusson, Viman Nagar</p>
            </div>
          </div>
        </a>
      </div>

      <div class="col-lg-6 col-md-12">
        <a href="/listings?search=Hyderabad" class="text-decoration-none">
          <div class="city-card" style="height: 240px;">
            <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=800&q=80" alt="Hyderabad">
            <div class="city-overlay">
              <h3 class="fw-bold text-white mb-1">Hyderabad</h3>
              <p class="text-light small mb-0"><i class="fa-solid fa-graduation-cap me-1"></i> HCU, Osmania, Gachibowli Tech Hub</p>
            </div>
          </div>
        </a>
      </div>
