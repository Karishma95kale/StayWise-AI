  </div>
</section>

<!-- 4. Featured Properties Section -->
<section id="properties" class="py-5">
  <div class="container py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
      <div>
        <span class="badge-pink mb-2 d-inline-block">Curated Residences</span>
        <h2 class="section-heading mb-0">Featured Student Accommodations</h2>
      </div>

      <a href="/listings" class="btn btn-outline-navy">View All Properties &rarr;</a>
    </div>

    <!-- Accommodations Grid -->
    <% if(allListings.length === 0){ %>
      <div class="startup-card p-5 text-center my-4">
        <i class="fa-solid fa-building-circle-xmark display-3 text-muted mb-3"></i>
        <h3 class="fw-bold">No Properties Found</h3>
        <p class="text-muted">Try resetting your search parameters.</p>
        <a href="/listings" class="btn btn-pink-gradient px-4 mt-2">Reset Filters</a>
      </div>
    <% } else { %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
        <% for(let hostel of allListings){ %>
          <div class="col">
            <div class="startup-card h-100 position-relative">
              <!-- Wishlist Heart Button -->
              <button onclick="toggleWishlist('<%= hostel._id %>', this)" class="btn rounded-circle position-absolute top-0 end-0 m-3 z-3 bg-white shadow-sm border-0 p-2 text-dark" title="Save to Wishlist">
                <i class="<%= userWishlist.includes(hostel._id.toString()) ? 'fa-solid text-danger' : 'fa-regular' %> fa-heart fs-5"></i>
              </button>

              <a href="/listings/<%= hostel._id %>" class="text-decoration-none text-dark">
                <!-- Image Slider Frame -->
                <div class="card-img-frame">
                  <img src="<%= hostel.image ? hostel.image.url : 'https://images.unsplash.com/photo-1555854877-bab0e564b8d5?auto=format&fit=crop&w=800&q=80' %>" class="card-img-zoom" alt="<%= hostel.title %>">
                  
                  <div class="position-absolute bottom-0 start-0 m-3 d-flex gap-2">
                    <span class="badge-pink shadow-sm">
                      <i class="fa-solid fa-brain me-1"></i> <%= hostel.aiRecommendationScore %>% AI Match
                    </span>
                    <span class="badge-safety shadow-sm bg-white">
                      <i class="fa-solid fa-shield-check me-1"></i> Safety <%= hostel.safetyScore %>/100
                    </span>
                  </div>
                </div>

                <!-- Card Body -->
                <div class="p-4 d-flex flex-column justify-content-between">
                  <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <h4 class="card-title-custom mb-0 text-truncate" style="max-width: 75%;"><%= hostel.title %></h4>
                      <div class="d-flex align-items-center gap-1 text-warning font-weight-bold small">
                        <i class="fa-solid fa-star"></i> <%= hostel.rating ? hostel.rating.toFixed(1) : '4.5' %>
                      </div>
                    </div>

                    <p class="text-muted small mb-2 text-truncate">
                      <i class="fa-solid fa-graduation-cap text-navy me-1"></i> <%= hostel.college %> 
                      <span class="text-pink font-weight-bold" style="color: var(--primary-pink);">(<%= hostel.distanceFromCollege %> km)</span>
                    </p>

                    <p class="text-muted small mb-3 text-truncate">
                      <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= hostel.location %>
                    </p>

                    <!-- Amenities Chips -->
                    <div class="d-flex flex-wrap gap-1 mb-3">
                      <span class="badge badge-navy"><%= hostel.roomType %></span>
                      <span class="badge badge-navy"><%= hostel.gender %></span>
                      <% if(hostel.messAvailable){ %>
                        <span class="badge bg-light text-dark border"><i class="fa-solid fa-utensils me-1 text-warning"></i> Mess</span>
                      <% } %>
                      <% if(hostel.wifiAvailable){ %>
                        <span class="badge bg-light text-dark border"><i class="fa-solid fa-wifi me-1 text-info"></i> WiFi</span>
                      <% } %>
                    </div>
                  </div>

                  <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                    <div>
                      <span class="fs-4 fw-bold text-navy">₹<%= hostel.price.toLocaleString('en-IN') %></span>
                      <span class="text-muted text-xs">/month</span>
                    </div>
                    <span class="btn btn-navy btn-sm px-3 rounded-pill">
                      View Details <i class="fa-solid fa-arrow-right ms-1 text-xs"></i>
                    </span>
                  </div>
                </div>
              </a>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

