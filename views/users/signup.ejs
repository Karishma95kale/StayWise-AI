<%- include('../listing/partials/header') -%>

<div class="container my-5">
  <div class="startup-card overflow-hidden shadow-lg border-0">
    <div class="row g-0">
      <!-- Left Side: Lifestyle Banner -->
      <div class="col-lg-5 d-none d-lg-block position-relative p-5 text-white d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, rgba(233, 30, 99, 0.9) 0%, rgba(20, 33, 61, 0.95) 100%), url('https://images.unsplash.com/photo-1555854877-bab0e564b8d5?auto=format&fit=crop&w=1000&q=80') center/cover;">
        <div>
          <span class="badge bg-white text-pink font-weight-bold px-3 py-2 rounded-pill mb-3" style="color: var(--primary-pink);">Join StayWise AI</span>
          <h2 class="display-6 fw-bold text-white mb-3">Begin Your Student Housing Journey</h2>
          <p class="fs-6 opacity-90 leading-relaxed">
            Create an account to unlock AI roommate matching, zero brokerage bookings, and AI recommendation scores.
          </p>
        </div>

        <div class="pt-5 border-top border-light border-opacity-25">
          <div class="d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-white text-pink p-2 fs-5" style="color: var(--primary-pink); width: 36px; height: 36px; text-center;">1</div>
              <span class="fw-semibold">Select Student or Property Owner</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-white text-pink p-2 fs-5" style="color: var(--primary-pink); width: 36px; height: 36px; text-center;">2</div>
              <span class="fw-semibold">Enter Details & College Preferences</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-white text-pink p-2 fs-5" style="color: var(--primary-pink); width: 36px; height: 36px; text-center;">3</div>
              <span class="fw-semibold">Explore AI Powered Recommendations</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Side: Signup Form -->
      <div class="col-lg-7 p-4 p-md-5 bg-white d-flex flex-column justify-content-center">
        <div class="mb-4">
          <h2 class="fw-bold text-navy mb-1">Create Account</h2>
          <p class="text-muted small">Sign up as a University Student or Property Owner</p>
        </div>

        <form action="/signup" method="POST" class="needs-validation" novalidate>
          <!-- Role Selection Cards -->
          <div class="mb-4">
            <label class="form-label text-muted small fw-semibold text-uppercase">Account Role</label>
            <div class="row g-3">
              <div class="col-6">
                <label class="role-card-option d-block text-center active" id="role-student-label">
                  <input type="radio" name="role" value="student" class="d-none" checked onchange="toggleRoleSelect('student')">
                  <div class="role-content py-2">
                    <i class="fa-solid fa-user-graduate fs-3 mb-2 text-pink" style="color: var(--primary-pink);"></i>
                    <div class="fw-bold text-navy small">Student</div>
                    <div class="text-muted text-xs">Book Hostels & PGs</div>
                  </div>
                </label>
              </div>
              <div class="col-6">
                <label class="role-card-option d-block text-center" id="role-owner-label">
                  <input type="radio" name="role" value="owner" class="d-none" onchange="toggleRoleSelect('owner')">
                  <div class="role-content py-2">
                    <i class="fa-solid fa-building-user fs-3 mb-2 text-navy"></i>
                    <div class="fw-bold text-navy small">Property Owner</div>
                    <div class="text-muted text-xs">List & Manage Hostels</div>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label for="username" class="form-label text-muted small fw-semibold">Username</label>
              <input name="username" type="text" class="form-control bg-light" id="username" placeholder="e.g. rahul_du" required />
            </div>

            <div class="col-md-6">
              <label for="email" class="form-label text-muted small fw-semibold">Email Address</label>
              <input name="email" type="email" class="form-control bg-light" id="email" placeholder="name@example.com" required />
            </div>

            <div class="col-12">
              <label for="password" class="form-label text-muted small fw-semibold">Password</label>
              <input name="password" type="password" class="form-control bg-light" id="password" placeholder="••••••••" required />
            </div>

            <!-- Student Specific Fields -->
            <div id="student-fields" class="col-12">
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="collegeName" class="form-label text-muted small fw-semibold">College / University</label>
                  <input name="collegeName" type="text" class="form-control bg-light" id="collegeName" placeholder="e.g. Delhi University" />
                </div>
                <div class="col-md-6">
                  <label for="budget" class="form-label text-muted small fw-semibold">Monthly Budget (₹)</label>
                  <input name="budget" type="number" class="form-control bg-light" id="budget" placeholder="10000" />
                </div>
              </div>
            </div>

            <div class="col-12 mt-4">
              <button class="btn btn-pink-gradient w-100 py-3 fw-bold shadow" type="submit">
                <i class="fa-solid fa-rocket me-2"></i> Register Account
              </button>
            </div>
          </div>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
          <p class="text-muted small mb-0">Already have an account? <a href="/login" class="text-pink text-decoration-none fw-bold" style="color: var(--primary-pink);">Log In</a></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleRoleSelect(role) {
    document.querySelectorAll('.role-card-option').forEach(el => el.classList.remove('active'));
    if (role === 'student') {
      document.getElementById('role-student-label').classList.add('active');
      document.getElementById('student-fields').style.display = 'block';
    } else {
      document.getElementById('role-owner-label').classList.add('active');
      document.getElementById('student-fields').style.display = 'none';
    }
  }
</script>

<%- include('../includes/footer') -%>