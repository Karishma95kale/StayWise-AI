<%- include('listing/partials/header') -%>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
      <div class="startup-card p-5 text-center">
        <div class="rounded-circle p-3 d-inline-flex mb-3 text-danger fs-1" style="background: rgba(220, 38, 38, 0.1);">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h3 class="fw-bold text-navy mb-2">Notice / Error</h3>
        <p class="text-muted leading-relaxed mb-4"><%= message %></p>
        <div class="d-flex justify-content-center gap-2">
          <a href="/listings" class="btn btn-pink-gradient px-4 py-2">Back to Accommodations</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('includes/footer') -%>
